# Copy this file to `.env` and fill in the key for whichever provider you use.
# Which one is used is set by PROVIDER in llmqp/config.py (default: gemini).

# Gemini - free tier, no card required.  Get one at:
#   https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Claude - paid, needs credit on the account.  Get one at:
#   https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Ollama needs no key - just install it and run `ollama pull llama3.2:3b`.
